{
  "name": "ai-mystery-room",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && node scripts/check-frontend-secrets.js && npm run build --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:integration": "npm run test:integration --workspace=backend",
    "test:integration:generation": "npm run test:integration:generation --workspace=backend"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
